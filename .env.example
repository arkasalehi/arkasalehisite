# Supabase (required). HTTP-only — works on Node and Cloudflare Workers.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Public origin — set at BUILD time for Cloudflare (inlined into the client).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="آرکا صالحی"

# Optional: only if cookies must be shared across a parent domain
# COOKIE_DOMAIN=".arkasalehi.ir"

# First account with this email is promoted to ADMIN by the database trigger.
# Create it via /register, then sign in. Disable "Confirm email" in Supabase Auth
# if you want instant login like before.
# SEED_ADMIN_EMAIL="admin@arkasalehi.ir"
