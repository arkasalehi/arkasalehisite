# PostgreSQL (Node.js / self-hosted: `npm run dev` and `npm start`)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arkasalehi"

# Cloudflare Workers: Prisma Accelerate HTTP URL (optional locally)
# If set, queries use Accelerate instead of TCP. Same Prisma client.
# PRISMA_ACCELERATE_URL="prisma://..."

JWT_SECRET="replace-with-a-long-random-secret"
# Access JWT is 15 minutes; refresh cookie (as_refresh) lasts 30 days.

# Public origin — set at BUILD time for Cloudflare (inlined into the client).
# NEXT_PUBLIC_BASE_URL is the canonical name; SITE_URL is kept as alias.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="آرکا صالحی"

# Optional: only if cookies must be shared across a parent domain
# COOKIE_DOMAIN=".arkasalehi.ir"

# Seed admin (used only by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@arkasalehi.ir"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_USER_EMAIL="user@arkasalehi.ir"
SEED_USER_PASSWORD="User123!"
