# Supabase (required). HTTP-only — works on Node and Cloudflare Workers.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Public origin — set at BUILD time for Cloudflare (inlined into the client).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="آرکا صالحی"

# Shared session across arkasalehi.com and workspace.arkasalehi.com
# COOKIE_DOMAIN=".arkasalehi.com"
NEXT_PUBLIC_WORKSPACE_URL="https://workspace.arkasalehi.com"

# Bootstrap: reserved emails become admin only when ZERO admins exist.
# After that, new signups (including those emails) stay role=user.
# If Confirm email is on, register returns needsConfirmation instead of a session.
